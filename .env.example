# Smart Access — muhit o'zgaruvchilari namunasi.
# Nusxa oling: cp .env.example .env  va qiymatlarni o'zgartiring.
# Haqiqiy kalit va parollar faqat .env da (repozitoriyga yozilmaydi — BR-PRIV-06).

# --- Umumiy ---
DEMO_MODE=true
TENANT_CODE=demo
TZ=Asia/Tashkent

# --- PostgreSQL 16 ---
POSTGRES_DB=smartaccess
POSTGRES_USER=smartaccess
POSTGRES_PASSWORD=change-me
ConnectionStrings__Default=Host=postgres;Port=5432;Database=smartaccess;Username=smartaccess;Password=change-me

# --- Redis ---
REDIS_URL=redis:6379

# --- Auth (BR-AUTH-05) ---
JWT_SIGNING_KEY=change-me-at-least-64-random-characters-change-me-at-least-64-random
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Shifrlash (BR-CAM-01, BR-PRIV-01): AES-256-GCM, base64 32 bayt ---
ENCRYPTION_KEY_BASE64=

# --- MinIO (snapshot, eksport, biometrik rasmlar — shifrlangan) ---
MINIO_ROOT_USER=smartaccess
MINIO_ROOT_PASSWORD=change-me-minio
S3_ENDPOINT=http://minio:9000
S3_BUCKET=smartaccess

# --- MediaMTX (VMS) ---
MEDIAMTX_API=http://mediamtx:9997

# --- PULSE integratsiyasi (kirish/chiqish hodisalarini uzatish) ---
PULSE_ENABLED=false
PULSE_BASE_URL=
PULSE_API_KEY=

# --- Domen (Caddy HTTPS, BR-PRIV-05) ---
PUBLIC_DOMAIN=localhost
